/* implementation of Lexical Analyzer using Lex Tool*/
%{
int COMMENT=0;
%}
Identifier [a-zA-Z][a-zA-Z0-9]*
%%
int|float|char|double|while|for|struct|typedef|do|if {printf("\n %s is a keyword",yytext);} "/*" {COMMENT=1;printf("\n\t %s is a COMMENT",yytext);}
{Identifier} {if(!COMMENT) printf("\n%s :Identifier\n",yytext);}
\{ {if(!COMMENT) printf("\n BLOCK BEGINS");}
\} {if(!COMMENT) printf("\n BLOCK END");}
[0-9]+ {if(!COMMENT) printf("\n%s is a NUMBER",yytext);}
\)(\:)? {if(!COMMENT) printf("\n"); ECHO; printf("\n");}
\(ECHO;
= {if(!COMMENT) printf("\n %s is an ASSIGNMENT OPERATOR",yytext);} ";" {printf("\n%s end of the statement",yytext);}
\<=|\>=|\<|==|\> {if(!COMMENT) printf("\n \t %s is a RELATIONAL OPERATOR",yytext);} #.* {printf("\n %s is a preprocessor directive",yytext);}
%%
